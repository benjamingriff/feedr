# Postgres from compose.yaml. The API tests use their own feedr_test database there, or TEST_DATABASE_URL.
DATABASE_URL=postgres://feedr:feedr@127.0.0.1:55433/feedr
PORT=4100
# Written by scripts/setup.sh. Clerk sign-in is off when CLERK_SECRET_KEY is empty; personal tokens always work.
CLERK_APP_ID=
CLERK_SECRET_KEY=
# OAuth on /mcp for connectors (claude.ai, Grok Bot) needs these too: the Clerk publishable key
# (pk_…, the same as the app's) and the API's public https address. Railway has them; local dev doesn't need them.
CLERK_PUBLISHABLE_KEY=
PUBLIC_URL=
# The production database's public address, for the pnpm prod:* commands. Only the main checkout's
# .env needs it; pnpm dev:setup never copies it into a worktree. Railway → Postgres → Connect → Public Network.
PROD_DATABASE_URL=
