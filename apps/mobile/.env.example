# Written to .env.local by scripts/setup.sh.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# The API the app talks to, e.g. http://192.168.1.10:4100 here, https://… in production.
# Both values are baked in when Metro bundles: restart it with --clear after changing them.
# Without both, the app says sign-in isn't available.
EXPO_PUBLIC_API_URL=
