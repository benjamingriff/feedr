{
  "expo": {
    "name": "feedr",
    "slug": "feedr",
    "scheme": "feedr",
    "version": "0.1.0",
    "icon": "./assets/icons/cobalt-light.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.benjamingriff.feedr",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/icons/cobalt-light.png",
        "dark": "./assets/icons/cobalt-dark.png",
        "tinted": "./assets/icons/tinted.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Clay",
            "ios": {
              "light": "./assets/icons/clay-light.png",
              "dark": "./assets/icons/clay-dark.png",
              "tinted": "./assets/icons/tinted.png"
            }
          },
          {
            "name": "Basil",
            "ios": {
              "light": "./assets/icons/basil-light.png",
              "dark": "./assets/icons/basil-dark.png",
              "tinted": "./assets/icons/tinted.png"
            }
          },
          {
            "name": "Yolk",
            "ios": {
              "light": "./assets/icons/yolk-light.png",
              "dark": "./assets/icons/yolk-dark.png",
              "tinted": "./assets/icons/tinted.png"
            }
          },
          {
            "name": "Beetroot",
            "ios": {
              "light": "./assets/icons/beetroot-light.png",
              "dark": "./assets/icons/beetroot-dark.png",
              "tinted": "./assets/icons/tinted.png"
            }
          }
        ]
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6ff87f38-cbf9-4a92-ad91-1b0d30407a55"
      }
    },
    "owner": "ben-jamin-griff",
    "updates": {
      "url": "https://u.expo.dev/6ff87f38-cbf9-4a92-ad91-1b0d30407a55"
    }
  }
}
