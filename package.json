{
  "name": "feedr",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "npm run dev -w @feedr/api",
    "dev:mobile": "npm run start -w @feedr/mobile",
    "db:migrate": "npm run migrate -w @feedr/api",
    "account:create": "npm run account -w @feedr/api",
    "seed": "npm run seed -w @feedr/api",
    "smoke:mcp": "npm run smoke:mcp -w @feedr/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
